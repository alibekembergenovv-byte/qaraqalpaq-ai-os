generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  keywords  String
  createdAt DateTime   @default(now())
  sources   Source[]
  newsItems NewsItem[]
}

model Source {
  id         String     @id @default(cuid())
  name       String
  url        String
  categoryId String
  createdAt  DateTime   @default(now())
  category   Category   @relation(fields: [categoryId], references: [id])
  newsItems  NewsItem[]
}

model NewsItem {
  id         String    @id @default(cuid())
  title      String
  summary    String?
  url        String    @unique
  published  DateTime
  sourceId   String
  categoryId String
  status     String    @default("NEW")
  createdAt  DateTime  @default(now())
  category   Category  @relation(fields: [categoryId], references: [id])
  source     Source    @relation(fields: [sourceId], references: [id])
  content    Content?
}

model Content {
  id         String   @id @default(cuid())
  newsItemId String   @unique
  title      String
  body       String
  imageUrl   String?
  format     String
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id])
}
